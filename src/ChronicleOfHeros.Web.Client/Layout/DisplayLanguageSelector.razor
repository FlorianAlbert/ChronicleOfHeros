@using System.Globalization
@inject NavigationManager NavigationManager
@inject IStringLocalizer<DisplayLanguageSelector> Localizer

<form class="display-language-selector" method="post" action="/display-language">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <select name="locale" aria-label="@Localizer["DisplayLanguage"]" title="@Localizer["DisplayLanguage"]">
        <option value="en-US" selected="@IsCurrentCulture("en-US")">English</option>
        <option value="de-DE" selected="@IsCurrentCulture("de-DE")">Deutsch</option>
    </select>
    <button type="submit">@Localizer["Apply"]</button>
</form>

@code {
    private string ReturnUrl
    {
        get
        {
            var currentUri = new Uri(NavigationManager.Uri);
            return currentUri.PathAndQuery + currentUri.Fragment;
        }
    }

    private static bool IsCurrentCulture(string cultureName) =>
        string.Equals(CultureInfo.CurrentUICulture.Name, cultureName, StringComparison.OrdinalIgnoreCase);
}
@using System.Globalization
@inject NavigationManager NavigationManager
@inject IStringLocalizer<DisplayLanguageSelector> Localizer

<form class="display-language-selector" method="post" action="/display-language">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <select name="locale" value="@CultureInfo.CurrentUICulture.Name" onchange="this.form.requestSubmit()" aria-label="@Localizer["DisplayLanguage"]" title="@Localizer["DisplayLanguage"]">
        <option value="en-US">English</option>
        <option value="de-DE">Deutsch</option>
    </select>
</form>

@code {
    private string ReturnUrl
    {
        get
        {
            var currentUri = new Uri(NavigationManager.Uri);
            return currentUri.PathAndQuery + currentUri.Fragment;
        }
    }

}
@namespace ChronicleOfHeros.Web.Client.Components

@implements IDisposable

@if (isHealthy is null)
{
	<span class="badge @(isTakingLonger ? "text-bg-warning" : "text-bg-secondary")" role="status">
		@if (isTakingLonger)
		{
			<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
			<span>Something seems off...</span>
		}
		else
		{
			<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
			<span class="visually-hidden">Checking health status</span>
		}
	</span>
}
else
{
	<span class="badge @(isHealthy.Value ? "text-bg-success" : "text-bg-danger")">@(isHealthy.Value ? "Healthy" : "Unavailable")</span>
}

@code {
	private const int SlowFeedbackDelaySeconds = 3;

	private readonly CancellationTokenSource cancellationTokenSource = new();

	private bool? isHealthy;
	private bool isTakingLonger;

	[Parameter, EditorRequired]
	public required Func<CancellationToken, Task<bool>> HealthCheck { get; set; }

	protected override Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			return CheckHealthAsync();
		}

		return Task.CompletedTask;
	}

	private async Task CheckHealthAsync()
	{
		try
		{
			Task<bool> healthCheck = GetHealthStatusAsync();
			await ShowSlowFeedbackIfNeededAsync(healthCheck);
			isHealthy = await healthCheck;
			StateHasChanged();
		}
		catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
		{
		}
	}

	private async Task ShowSlowFeedbackIfNeededAsync(Task healthCheck)
	{
		Task slowFeedbackDelay = Task.Delay(TimeSpan.FromSeconds(SlowFeedbackDelaySeconds), cancellationTokenSource.Token);

		if (await Task.WhenAny(healthCheck, slowFeedbackDelay) == slowFeedbackDelay && !cancellationTokenSource.IsCancellationRequested)
		{
			isTakingLonger = true;
			StateHasChanged();
		}
	}

	private Task<bool> GetHealthStatusAsync()
	{
		try
		{
			return HealthCheck(cancellationTokenSource.Token);
		}
		catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
		{
			throw;
		}
		catch
		{
			return Task.FromResult(false);
		}
	}

	public void Dispose()
	{
		cancellationTokenSource.Cancel();
		cancellationTokenSource.Dispose();
	}
}
@page "/"

@rendermode InteractiveAuto
@inject IStringLocalizer<Home> Localizer

<PageTitle>@Localizer["PageTitle"]</PageTitle>

<div class="landing-page">
    <header>
        <a class="wordmark" href="/">ChronicleOfHeros</a>
        <nav class="desktop-navigation" aria-label="@Localizer["PrimaryNavigation"]">
            <a href="#character-sheet">@Localizer["CharacterSheets"]</a>
            <a href="#how-it-works">@Localizer["HowItWorks"]</a>
            <a href="#about">@Localizer["About"]</a>
        </nav>
        <details class="navigation-disclosure">
            <summary title="@Localizer["NavigationMenu"]" aria-label="@Localizer["NavigationMenu"]"><span aria-hidden="true"></span></summary>
            <nav aria-label="@Localizer["PrimaryNavigation"]">
                <a href="#character-sheet">@Localizer["CharacterSheets"]</a>
                <a href="#how-it-works">@Localizer["HowItWorks"]</a>
                <a href="#about">@Localizer["About"]</a>
            </nav>
        </details>
        <button class="coming-soon" type="button" disabled>@Localizer["ComingSoon"]</button>
    </header>
    <main>
        <section class="field-hero" aria-labelledby="landing-title">
            <div>
                <p class="eyebrow">@Localizer["HeroEyebrow"]</p>
                <h1 id="landing-title">@Localizer["HeroTitle"]</h1>
                <p>@Localizer["HeroDescription"]</p>
                <a href="#how-it-works">@Localizer["SeeHowTheRecordWorks"]</a>
            </div>
            <div class="sheet" id="character-sheet">
                <p>@Localizer["CharacterRecord"]</p>
                <h2>Elian Thorn</h2>
                <span>@Localizer["ExampleCharacterSummary"]</span>
                <dl>
                    <div><dt>@Localizer["Armor"]</dt><dd>17</dd></div>
                    <div><dt>@Localizer["Initiative"]</dt><dd>+1</dd></div>
                    <div><dt>@Localizer["Speed"]</dt><dd>30 ft.</dd></div>
                </dl>
                <p>@Localizer["Strength"] 16 +3</p>
                <p>@Localizer["Constitution"] 14 +2</p>
                <p>@Localizer["Wisdom"] 12 +1</p>
            </div>
        </section>
        <section class="path" id="how-it-works" aria-label="@Localizer["HowItWorks"]">
            <article><b>01</b><h2>@Localizer["Build"]</h2><p>@Localizer["BuildDescription"]</p></article>
            <article><b>02</b><h2>@Localizer["Understand"]</h2><p>@Localizer["UnderstandDescription"]</p></article>
            <article><b>03</b><h2>@Localizer["Progress"]</h2><p>@Localizer["ProgressDescription"]</p></article>
        </section>
        <section class="about" id="about" aria-labelledby="about-title">
            <p class="eyebrow">@Localizer["AboutEyebrow"]</p>
            <div>
                <h2 id="about-title">@Localizer["AboutHeading"]</h2>
                <p>@Localizer["AboutDescription"]</p>
            </div>
        </section>
    </main>
</div>

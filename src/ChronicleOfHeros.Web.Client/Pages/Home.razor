@page "/"

@rendermode InteractiveAuto

@using ChronicleOfHeros.Web.Client.Components
@using ChronicleOfHeros.Web.Client.Services.Abstractions.HealthReportService;

@inject IHealthReportService HealthReportService

@implements IDisposable

<PageTitle>Home</PageTitle>

<h1>Application Health</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
	<p class="mb-0">Current readiness status for the Web application and API.</p>
	<button type="button" class="btn btn-outline-primary d-inline-flex align-items-center gap-2" @onclick="RefreshHealthChecks" disabled="@isRefreshCoolingDown">
		<span>Refresh</span>
		@if (isRefreshCoolingDown)
		{
			<span class="refresh-countdown" style="--countdown-progress: @CountdownProgress;" role="status" aria-label="Refresh is available in @secondsUntilRefresh seconds">
				<span class="refresh-countdown-value">@secondsUntilRefresh</span>
			</span>
		}
	</button>
</div>

<ul class="list-group">
	<li class="list-group-item d-flex justify-content-between align-items-center">
		Web application
		<HealthStatusBadge @key="healthCheckRefreshVersion" HealthCheck="HealthReportService.IsHealthyAsync" />
	</li>
	<li class="list-group-item d-flex justify-content-between align-items-center">
		API
		<HealthStatusBadge @key="healthCheckRefreshVersion" HealthCheck="HealthReportService.IsApiHealthyAsync" />
	</li>
</ul>

@code {
	private const int RefreshIntervalSeconds = 60;
	private readonly CancellationTokenSource cancellationTokenSource = new();
	private readonly PeriodicTimer refreshTimer = new(TimeSpan.FromSeconds(1));

	private int healthCheckRefreshVersion;
	private bool isRefreshCoolingDown;
	private int secondsUntilRefresh;

	private int CountdownProgress => secondsUntilRefresh * 100 / RefreshIntervalSeconds;

	private void RefreshHealthChecks()
	{
		healthCheckRefreshVersion++;
		secondsUntilRefresh = RefreshIntervalSeconds;
		isRefreshCoolingDown = true;
		_ = RunRefreshCooldownAsync();
	}

	private async Task RunRefreshCooldownAsync()
	{
		try
		{
			while (isRefreshCoolingDown && await refreshTimer.WaitForNextTickAsync(cancellationTokenSource.Token))
			{
				await InvokeAsync(() =>
				{
					secondsUntilRefresh--;

					if (secondsUntilRefresh == 0)
					{
						isRefreshCoolingDown = false;
					}

					StateHasChanged();
				});
			}
		}
		catch (OperationCanceledException) when (cancellationTokenSource.IsCancellationRequested)
		{
		}
	}

	public void Dispose()
	{
		cancellationTokenSource.Cancel();
		refreshTimer.Dispose();
		cancellationTokenSource.Dispose();
	}
}

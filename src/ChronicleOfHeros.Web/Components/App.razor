@using Microsoft.AspNetCore.Diagnostics

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ChronicleOfHeros.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet />
</head>

<body>
    <CascadingValue Name="OriginalPathAndQuery" Value="@OriginalPathAndQuery">
        <Routes />
    </CascadingValue>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start({
            webAssembly: {
                applicationCulture: '@CultureInfo.CurrentCulture.Name'
            }
        });
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? OriginalPathAndQuery
    {
        get
        {
            var reExecuteFeature = HttpContext?.Features.Get<IStatusCodeReExecuteFeature>();
            return reExecuteFeature is null
                ? null
                : reExecuteFeature.OriginalPathBase
                  + reExecuteFeature.OriginalPath
                  + reExecuteFeature.OriginalQueryString;
        }
    }
}

# Exclude generated Entity Framework Core migrations from analysis
[src/ChronicleOfHeros.Identity.AspNetCore/Data/Migrations/*.cs]
generated_code = true

# Exclude CA1707 "Identifiers should not contain underscores" for test files
[src/ChronicleOfHeros.AppHost.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none

[src/ChronicleOfHeros.Identity.AspNetCore.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
